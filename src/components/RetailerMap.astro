---
// src/components/RetailerMap.astro
import 'leaflet/dist/leaflet.css';

export interface Retailer {
  name: string;
  street: string;
  city: string;
  state: string;
  zip: string;
  phone?: string;
  url?: string;
  lat: number;
  lng: number;
}

interface Props {
  retailers: Retailer[];
}

const { retailers } = Astro.props;
---

<div class="map-container-wrapper">
  <div
    id="retailer-map"
    role="region"
    aria-label="Laurieville Farms Retailer Locations Map"
    data-retailers={JSON.stringify(retailers)}
  ></div>
</div>

<div class="map-controls">
  <button type="button" id="near-me-btn" class="btn-map-control">
    <span aria-hidden="true">📍</span> Near me
  </button>
  <button type="button" id="reset-map-btn" class="btn-map-control btn-map-secondary">
    Show all stores
  </button>
  <span id="map-status" class="map-status" aria-live="polite"></span>
</div>

<script>
  import L from 'leaflet';

  interface RetailerData {
    name: string;
    street: string;
    city: string;
    state: string;
    zip: string;
    lat: number;
    lng: number;
  }

  let activeMap: L.Map | null = null;
  let markersByName = new Map<string, L.Marker>();
  let allBounds: L.LatLngBounds | null = null;
  let userMarker: L.CircleMarker | null = null;

  /** Create a high-contrast Charcoal & Honey Gold SVG pin icon. */
  function createStoreIcon(): L.DivIcon {
    return L.divIcon({
      className: 'laurieville-pin',
      html: `<svg width="28" height="38" viewBox="0 0 28 38" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M14 1C6.82 1 1 6.82 1 14C1 23.75 14 37 14 37C14 37 27 23.75 27 14C27 6.82 21.18 1 14 1Z" fill="#212121" stroke="#fffdf7" stroke-width="2"/>
        <circle cx="14" cy="14" r="5.5" fill="#E8A50E"/>
      </svg>`,
      iconSize: [28, 38],
      iconAnchor: [14, 38],
      popupAnchor: [0, -34],
    });
  }

  /** Build accessible popup DOM content for a retailer pin. */
  function buildPopupContent(retailer: RetailerData): HTMLElement {
    const container = document.createElement('div');
    container.className = 'retailer-popup';

    const title = document.createElement('strong');
    title.className = 'retailer-popup-title';
    title.textContent = retailer.name;
    container.appendChild(title);

    const address = document.createElement('p');
    address.className = 'retailer-popup-address';
    address.appendChild(document.createTextNode(retailer.street));
    address.appendChild(document.createElement('br'));
    address.appendChild(
      document.createTextNode(`${retailer.city}, ${retailer.state} ${retailer.zip}`)
    );
    container.appendChild(address);

    const directionsLink = document.createElement('a');
    const destination = encodeURIComponent(`${retailer.lat},${retailer.lng}`);
    directionsLink.href = `https://www.google.com/maps/dir/?api=1&destination=${destination}`;
    directionsLink.target = '_blank';
    directionsLink.rel = 'noopener noreferrer';
    directionsLink.className = 'retailer-popup-directions';
    directionsLink.textContent = 'Get Directions';
    container.appendChild(directionsLink);

    return container;
  }

  function initRetailerMap(): void {
    const mapEl = document.getElementById('retailer-map');
    if (!mapEl) return;

    // Clean up any previous map instance (e.g., after Astro View Transitions)
    if (activeMap) {
      activeMap.remove();
      activeMap = null;
    }
    markersByName = new Map<string, L.Marker>();
    userMarker = null;

    const rawRetailers = mapEl.getAttribute('data-retailers');
    if (!rawRetailers) return;

    let retailers: RetailerData[] = [];
    try {
      retailers = JSON.parse(rawRetailers) as RetailerData[];
    } catch {
      return;
    }

    const validRetailers = retailers.filter(
      (r) => typeof r.lat === 'number' && typeof r.lng === 'number'
    );
    if (validRetailers.length === 0) return;

    const map = L.map(mapEl, {
      scrollWheelZoom: false,
    });
    activeMap = map;

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors',
      maxZoom: 19,
    }).addTo(map);

    const storeIcon = createStoreIcon();
    const bounds = L.latLngBounds([]);

    for (const retailer of validRetailers) {
      const coords: L.LatLngExpression = [retailer.lat, retailer.lng];
      const marker = L.marker(coords, {
        icon: storeIcon,
        title: retailer.name,
        alt: retailer.name,
      })
        .addTo(map)
        .bindPopup(buildPopupContent(retailer));

      markersByName.set(retailer.name, marker);
      bounds.extend(coords);
    }

    allBounds = bounds;
    map.fitBounds(bounds, { padding: [40, 40], maxZoom: 13 });

    for (const [name, marker] of markersByName) {
      const markerEl = marker.getElement();
      if (markerEl) {
        markerEl.setAttribute('aria-label', name);
      }
    }

    const statusEl = document.getElementById('map-status');
    const nearMeBtn = document.getElementById('near-me-btn') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('reset-map-btn') as HTMLButtonElement | null;

    if (resetBtn) {
      resetBtn.onclick = () => {
        if (activeMap && allBounds) {
          activeMap.closePopup();
          activeMap.fitBounds(allBounds, { padding: [40, 40], maxZoom: 13, animate: true });
          if (statusEl) statusEl.textContent = 'Showing all retail partners.';
        }
      };
    }

    if (nearMeBtn) {
      nearMeBtn.onclick = () => {
        if (!('geolocation' in navigator)) {
          if (statusEl) statusEl.textContent = 'Location is not supported by your browser.';
          return;
        }

        nearMeBtn.disabled = true;
        if (statusEl) statusEl.textContent = 'Finding your location…';

        navigator.geolocation.getCurrentPosition(
          (position) => {
            nearMeBtn.disabled = false;
            if (!activeMap) return;

            const { latitude, longitude } = position.coords;
            const userLatLng: L.LatLngExpression = [latitude, longitude];

            if (userMarker) {
              userMarker.setLatLng(userLatLng);
            } else {
              userMarker = L.circleMarker(userLatLng, {
                radius: 9,
                color: '#ffffff',
                weight: 3,
                fillColor: '#1d4ed8',
                fillOpacity: 1,
              })
                .addTo(activeMap)
                .bindPopup('<strong>You are here</strong>');
            }

            activeMap.setView(userLatLng, 11, { animate: true });
            userMarker.openPopup();
            if (statusEl) statusEl.textContent = 'Centered on your location.';
          },
          () => {
            nearMeBtn.disabled = false;
            if (statusEl) {
              statusEl.textContent = 'Location access was denied or unavailable.';
            }
          },
          { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 }
        );
      };
    }
  }

  function handleRetailerSelect(event: Event): void {
    const customEvent = event as CustomEvent<{ storeName?: string }>;
    const storeName = customEvent.detail?.storeName;
    if (!storeName || !activeMap) return;

    const marker = markersByName.get(storeName);
    if (!marker) return;

    activeMap.setView(marker.getLatLng(), 15, { animate: true });
    marker.openPopup();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRetailerMap);
  } else {
    initRetailerMap();
  }

  document.addEventListener('astro:page-load', initRetailerMap);
  document.addEventListener('retailer:select', handleRetailerSelect);
</script>

<style>
  .map-container-wrapper {
    width: 100%;
    height: 280px;
    border: 2px solid var(--color-charcoal);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    position: relative;
    z-index: 1;
  }

  @media (min-width: 992px) {
    .map-container-wrapper {
      height: 450px;
    }
  }

  #retailer-map {
    width: 100%;
    height: 100%;
  }

  .map-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .btn-map-control {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background-color: var(--color-charcoal);
    color: var(--color-gold);
    border: 2px solid var(--color-charcoal);
    border-radius: 4px;
    padding: 0.5rem 0.9rem;
    font-size: 0.9rem;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .btn-map-control:hover:not(:disabled) {
    background-color: var(--color-gold);
    color: var(--color-charcoal);
  }

  .btn-map-control:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .btn-map-secondary {
    background-color: transparent;
    color: var(--color-charcoal);
  }

  .btn-map-secondary:hover:not(:disabled) {
    background-color: var(--color-charcoal);
    color: var(--color-cream);
  }

  .map-status {
    font-size: 0.9rem;
    color: var(--color-charcoal);
  }

  /* Leaflet custom pin and popup styles */
  :global(.laurieville-pin) {
    background: transparent;
    border: none;
  }

  :global(.retailer-popup) {
    font-family: var(--font-sans, sans-serif);
    color: #212121;
    line-height: 1.45;
    min-width: 180px;
  }

  :global(.retailer-popup-title) {
    display: block;
    font-size: 1rem;
    color: #212121;
    margin-bottom: 0.35rem;
  }

  :global(.retailer-popup-address) {
    margin: 0 0 0.65rem 0;
    font-size: 0.9rem;
    color: #212121;
  }

  :global(.retailer-popup-directions) {
    display: inline-block;
    background-color: #212121;
    color: #E8A50E !important;
    padding: 0.4rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: bold;
    text-decoration: none;
    border: 2px solid #212121;
  }

  :global(.retailer-popup-directions:hover) {
    background-color: #E8A50E;
    color: #212121 !important;
  }

  :global(.leaflet-control-attribution) {
    background-color: rgba(255, 255, 255, 0.92) !important;
    color: #212121 !important;
  }

  :global(.leaflet-control-attribution a) {
    color: #004e75 !important;
  }
</style>

