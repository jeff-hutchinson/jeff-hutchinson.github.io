---
// src/pages/learning/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const learningEntries = await getCollection('learning');

// Sort in ascending order based on the seriesOrder frontmatter field
learningEntries.sort((a, b) => a.data.seriesOrder - b.data.seriesOrder);

const title = "Learning Center - Laurieville Farms";
const description = "Explore our sequential beekeeping curriculum and learn the art and science of hive management.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <section class="learning-hero">
    <div class="hero-content">
      <h1>Beekeeping Curriculum</h1>
      <p>A sequential, step-by-step learning guide written from the hive's perspective. Start from the foundation and grow your apiary knowledge.</p>
    </div>
  </section>

  <!-- Curriculum List Section -->
  <section class="curriculum-section container">
    <div class="curriculum-container">
      <h2>Curriculum Lessons</h2>
      <div class="lessons-grid">
        {learningEntries.map((entry) => (
          <article class="lesson-card">
            <div class="lesson-header">
              <h3 class="lesson-title">{entry.data.title}</h3>
            </div>
            <div class="lesson-body">
              <p class="lesson-description">{entry.data.description}</p>
            </div>
            <div class="lesson-footer">
              <a href={`/learning/${entry.id}`} class="btn-primary">Read Lesson</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section styling */
  .learning-hero {
    background-color: var(--color-charcoal);
    color: var(--color-cream);
    padding: 4rem 1.5rem;
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-content h1 {
    font-size: 3rem;
    color: var(--color-gold);
    margin-bottom: 1rem;
    font-family: var(--font-serif);
  }

  .hero-content p {
    font-size: 1.25rem;
    line-height: 1.6;
    margin: 0;
    color: var(--color-cream);
    font-family: var(--font-sans);
  }

  /* Curriculum Grid styling */
  .curriculum-section {
    padding: 2rem 0;
  }

  .curriculum-container h2 {
    font-size: 2.25rem;
    color: var(--color-charcoal);
    margin-bottom: 2rem;
    border-bottom: 3px solid var(--color-gold);
    padding-bottom: 0.5rem;
    display: inline-block;
    font-family: var(--font-serif);
  }

  .lessons-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .lessons-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .lessons-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  /* Card styling matching product-card */
  .lesson-card {
    background-color: #2a2a2a;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: none;
  }

  .lesson-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  }

  .lesson-header {
    background-color: #2a2a2a;
    padding: 2rem 2rem 0.5rem;
  }

  .lesson-title {
    font-size: 1.6rem;
    color: var(--color-gold);
    margin: 0;
    line-height: 1.3;
    font-family: var(--font-serif);
  }

  .lesson-body {
    padding: 1rem 2rem 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .lesson-description {
    font-size: 0.95rem;
    color: var(--color-cream);
    line-height: 1.6;
    margin: 0;
    font-family: var(--font-sans);
    flex-grow: 1;
  }

  .lesson-footer {
    padding: 0 2rem 2rem;
  }

  .btn-primary {
    display: inline-block;
    background-color: var(--color-gold);
    color: var(--color-charcoal);
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    font-weight: bold;
    text-transform: uppercase;
    transition: background-color 0.2s ease, transform 0.2s ease;
    text-align: center;
    border: none;
    text-decoration: none;
    width: 100%;
    font-family: var(--font-sans);
  }

  .btn-primary:hover {
    background-color: #e69a1f;
    color: var(--color-cream);
    text-decoration: none;
    transform: translateY(-2px);
  }
</style>
