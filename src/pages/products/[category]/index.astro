---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import catalogData from '../../../data/products.json';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// Astro's SSG function to generate the raw URLs mathematically
export function getStaticPaths() {
  // Extract all unique categories directly from the products array natively
  // We exclude 'honey' and 'candles' here because they have their own static pages (honey.astro and candles.astro)
  const uniqueCategories = [...new Set(catalogData.products.map((p: any) => p.category))]
    .filter(cat => cat !== 'honey' && cat !== 'candles');
  
  return uniqueCategories.map((cat) => ({
    params: { category: cat },
    props: { 
      categoryData: { header: `Explore our premium collection of handcrafted ${cat}.` },
      products: catalogData.products.filter((p: any) => p.category === cat)
    }
  }));
}

const { category } = Astro.params;
const { categoryData, products } = Astro.props;

const isWoodenwareComingSoon = category.toLowerCase() === 'woodenware';

// Formatting the title cleanly (e.g., 'woodenware' -> 'Woodenware')
const title = category.charAt(0).toUpperCase() + category.slice(1);

// Map specific hero images to generic category names dynamically
const localImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpeg,jpg,png,gif}');
const categoryHeroMap: Record<string, string> = {
  'woodenware': '/src/assets/covers.jpg',
  'honey': '/src/assets/honey-jar.jpg',
  'candles': '/src/assets/candle.jpg'
};
const heroImageUrl = categoryHeroMap[category.toLowerCase()] || '/src/assets/hero.jpg';
const heroImagePromise = localImages[heroImageUrl];
---

<BaseLayout pageTitle={`${title} | Laurieville Farms`}>
  {/* Utilizing the established 'Split-Block' High Contrast Hero rule */}
  <section class="page-hero">
    <div class="hero-bg-wrapper">
      {heroImagePromise && (
        <Image src={heroImagePromise()} alt={`${title} cover image`} width={1920} format="webp" loading="eager" decoding="async" class="hero-img" />
      )}
    </div>
    <div class="hero-content">
      <h1>{title}</h1>
      <p>
        {isWoodenwareComingSoon
          ? 'Coming soon — new supplier and lower prices on the way.'
          : categoryData.header}
      </p>
    </div>
  </section>

  <section class="products-grid wrapper">
    {isWoodenwareComingSoon ? (
      <div class="coming-soon-notice">
        <h2>Coming Soon</h2>
        <p>
          We are currently transitioning our beekeeping supplies to a new online storefront and partnering with a new supplier.
          Because we will no longer be building every piece by hand in-house, you can expect <strong>much lower prices</strong> when our woodenware lineup returns!
        </p>
        <p class="coming-soon-contact">
          Have questions in the meantime? Reach out at{' '}
          <a href="mailto:info@laurievillefarms.com">info@laurievillefarms.com</a> or call{' '}
          <a href="tel:8104746639">(810) 47-HONEY</a>.
        </p>
        <a href="/" class="btn-coming-soon">Return Home</a>
      </div>
    ) : products.length > 0 ? (
      <div class="grid-container">
        {products.map(product => (
          <ProductCard product={product} />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>New {title.toLowerCase()} arriving soon! Please check back later or contact us directly.</p>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .page-hero {
    display: flex;
    flex-direction: column;
    margin-bottom: 4rem;
  }

  .hero-bg-wrapper {
    position: relative;
    width: 100%;
    height: 40vh;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    background-color: var(--color-charcoal, #212121);
    padding: 1.5rem 2rem;
    text-align: center;
    color: var(--color-cream, #fffdf7);
  }

  .hero-content h1 {
    font-family: var(--font-serif, "Georgia", serif);
    font-size: 3rem;
    color: var(--color-gold, #E8A50E);
    margin-bottom: 0.5rem;
  }

  .hero-content p {
    font-size: 1.25rem;
    color: var(--color-cream, #fffdf7);
    margin: 0;
  }
  
  .wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 6rem;
  }

  @media (min-width: 1024px) {
    .wrapper {
      max-width: 1440px;
    }
  }

  /* Structural UI Rule: Mobile-first 1-column stacking */
  .grid-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* Tablet view: 2 columns */
  @media (min-width: 768px) {
    .grid-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Desktop view: 3 columns */
  @media (min-width: 1024px) {
    .grid-container {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background-color: #f7f3ec; /* Cream derivative */
    border: 1px dashed var(--color-charcoal, #212121);
    border-radius: 8px;
    color: var(--color-charcoal, #212121);
    font-style: italic;
  }

  .coming-soon-notice {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    padding: 3rem 2rem;
    background-color: #ffffff;
    border-top: 4px solid var(--color-gold, #E8A50E);
    border-left: 1px solid #e5e5e5;
    border-right: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    color: var(--color-charcoal, #212121);
  }

  .coming-soon-notice h2 {
    font-family: var(--font-serif, "Georgia", serif);
    font-size: 2.25rem;
    color: var(--color-charcoal, #212121);
    margin: 0 0 1.25rem 0;
  }

  .coming-soon-notice p {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-charcoal, #212121);
    margin: 0 0 1.25rem 0;
  }

  .coming-soon-contact a {
    color: var(--color-charcoal, #212121);
    font-weight: bold;
    text-decoration: underline;
  }

  .coming-soon-contact a:hover {
    text-decoration: none;
  }

  .btn-coming-soon {
    display: inline-block;
    margin-top: 0.75rem;
    background-color: var(--color-charcoal, #212121);
    color: var(--color-gold, #E8A50E);
    padding: 0.85rem 1.75rem;
    border: 2px solid var(--color-charcoal, #212121);
    border-radius: 4px;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .btn-coming-soon:hover {
    background-color: var(--color-gold, #E8A50E);
    color: var(--color-charcoal, #212121);
    transform: translateY(-2px);
  }
</style>
